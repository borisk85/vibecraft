{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/inject_violations.py'"
          },
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/inject_rules.py'",
            "statusMessage": "Подмешиваю жесткие правила vibecraft"
          },
          {
            "type": "command",
            "command": "python 'C:/Users/bkoma/.claude/hooks/inject_reference_stop.py'",
            "statusMessage": "Проверяю задачу на референс"
          },
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/inject_open_tasks.py'",
            "statusMessage": "Всплываю незакрытые задачи с прошлых сессий"
          },
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/inject_attachments.py'",
            "statusMessage": "Спасаю вложения из сообщений, присланных во время работы"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/validate_text.py'",
            "statusMessage": "validate_text: проверяю ё / запрещенные слова / сочиненные факты"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Users/bkoma/.claude/hooks/check_no_project_switch.py'",
            "statusMessage": "check_no_project_switch: не прыгать на другой проект без команды"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Users/bkoma/.claude/hooks/check_no_deploy_destruction.py'",
            "statusMessage": "check_no_deploy_destruction: деплой-очередь руками не трогать"
          },
          {
            "type": "command",
            "command": "python 'C:/Users/bkoma/.claude/hooks/check_no_bg_quick.py'",
            "statusMessage": "check_no_bg_quick: быстрый grep/read — foreground, не в фон"
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Users/bkoma/.claude/hooks/check_websearch_not_basic.py'",
            "statusMessage": "check_websearch_not_basic: поиск только под внешние факты"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Users/bkoma/.claude/hooks/ref_guard.py'",
            "statusMessage": "ref_guard: проверяю что референс vibecraft открыт"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Users/bkoma/.claude/hooks/no_action_on_question.py'",
            "statusMessage": "no_action_on_question: правка продукта — только по команде, не на вопрос/критику"
          },
          {
            "type": "command",
            "command": "python 'C:/Users/bkoma/.claude/hooks/check_justify_not_delete.py'",
            "statusMessage": "check_justify_not_delete: источник под вопросом — обоснуй, не удаляй молча"
          },
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/check_no_regressive_action.py'",
            "statusMessage": "check_no_regressive_action: не отключать/убирать фичу правкой ради обхода проблемы"
          },
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/check_table_house_format.py'",
            "statusMessage": "check_table_house_format: таблица блога — первый столбец целиком жирный, без приписок"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/check_build_before_push.py'",
            "statusMessage": "check_build_before_push: нет локального билда после правки исходника — не пушить/деплоить"
          },
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/check_no_micro_deploy.py'",
            "statusMessage": "check_no_micro_deploy: не деплоить каждую мелкую правку — копить батч, один деплой"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/hook_group.py' content",
            "statusMessage": "Референс и запрет отсебятины в копи"
          },
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/hook_group.py' visual",
            "statusMessage": "Визуал: не вслепую и без непрошенного"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/hook_group.py' visual",
            "statusMessage": "Playwright только когда он нужен"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|TodoWrite|Read|Glob|Grep|Task|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/hook_group.py' queue",
            "statusMessage": "Дисциплина очереди задач"
          },
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/hook_group.py' style",
            "statusMessage": "Стиль реплики"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Users/bkoma/.claude/hooks/ref_guard.py'"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Users/bkoma/.claude/hooks/check_sweep_all_pages.py'",
            "statusMessage": "check_sweep_all_pages: паттерн заменен — проверяю, не остался ли в других местах"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/persist_open_tasks.py'"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python 'C:/Claude Code/vibecraft/.claude/stop_soft.py'"
          }
        ]
      }
    ]
  }
}
